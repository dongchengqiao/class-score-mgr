{
  "name": "class-score-mgr-desktop",
  "productName": "班级积分管理",
  "version": "1.0.5",
  "description": "班级积分管理系统 · 桌面版",
  "main": "main.js",
  "private": true,
  "author": "dongchengqiao",
  "license": "MIT",
  "scripts": {
    "prepare:app": "node ../scripts/prepare-electron-app.js",
    "start": "node ../scripts/prepare-electron-app.js && electron stage",
    "dist": "node ../scripts/prepare-electron-app.js && electron-builder --config electron-builder.yml --publish never",
    "dist:mac": "node ../scripts/prepare-electron-app.js && electron-builder --config electron-builder.yml --mac --x64 --arm64 --publish never",
    "dist:win": "node ../scripts/prepare-electron-app.js && electron-builder --config electron-builder.yml --win --x64 --arm64 --publish never && node ../scripts/prune-windows-artifacts.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  }
}
